<!--
  Copyright (c) 2026 bentzn
  SPDX-License-Identifier: Apache-2.0
  Author Claude/bentzn

  Raposza OIDC - the shared identity provider. `raposza_oidc.md` is the
  authority; D-774 is the decision and `todo.md` A-32 the agreed-work row.

  THE PARENT IS spring-boot-starter-parent, NOT a Raposza parent, and that is
  carried over from `apps/jwtmint`'s pom with its reasoning intact: importing
  spring-boot-dependencies into a module whose parent already pins Jackson,
  slf4j and JUnit leaves the winner of each collision decided by
  dependencyManagement precedence, and the losing case is a NoSuchMethodError
  at the first request rather than anything the build reports.

  THIS TREE HAS ITS OWN REACTOR and is named by neither `raposza/pom.xml` nor
  `private/tools/pom.xml`. `workspace_structure.md` section 2 requires a tree's
  boundary to be STATED rather than read off its directory name, and
  `raposza_oidc.md` section 4 is that statement.

  NIMBUS IS PINNED rather than left to Boot's management, because the JOSE code
  in oidc-core is compiled against this version and `raposza-auth` resolves the
  same one. Bump both together or neither.

  THE GROUP IS `com.raposza.oidc` - his correction, 2026-09-19 - NOT
  `com.raposza`, which is what the rest of the workspace publishes under. The
  local repository path moves with it, to `com/raposza/oidc/...`, and two
  places look the jar up by that path rather than by coordinate:
  `raposza/run-jwtmint.sh` and `JwtMintProcess.STR_PATH_ARTIFACT`. Both are
  corrected in the same delivery. A subgroup needs no separate verification at
  Central: the TXT record that proves `com.raposza` covers everything beneath
  it.

  0.5.1 SINCE 2026-10-06 - his number: the dependency review of 2026-10-06
  before the release, no code change.

  0.5.0-SNAPSHOT SINCE 2026-10-05 - his number, released together with the
  Sandbox and the Workbench at 0.5.0: the settings renamed raposza.oidc.*
  and the old names refused.

  0.4.1-SNAPSHOT SINCE 2026-10-05 - his number: the security fixes after the
  0.4.0 release.

  0.4.0-SNAPSHOT SINCE 2026-09-23 - his number: the issuer is required, so a
  start that worked on 0.3.0 without it now refuses.

  THE VERSION IS 0.3.0-SNAPSHOT AND THE RELEASE IS 0.3.0 - his answer to OD-6,
  the same day. It develops as a SNAPSHOT and the push flips it, because Maven
  Central accepts a coordinate ONCE: a 0.3.0 rebuilt after the security review
  would have nowhere to go. The number deliberately does not track `raposza/`'s
  0.1.0-SNAPSHOT - the two trees release separately, and
  `raposza.oidc.version` in `raposza/platform/pom.xml` is the one place that
  names it.

  MAVEN CENTRAL IS THE TARGET - his answer to OD-5. What Central requires of
  the artefacts is at the bottom of this file; what it requires of the POM is
  immediately below.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.raposza.oidc</groupId>
    <artifactId>raposza-oidc</artifactId>
    <version>0.5.1</version>
    <packaging>pom</packaging>
    <name>Raposza OIDC</name>
    <description>The shared identity provider: a JWKS, an OpenID Provider surface and a mint.</description>
    <url child.project.url.inherit.append.path="false">https://github.com/raposza/OIDC</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- NO EMAIL ADDRESS. Central wants a developer entry and is satisfied by a
         name and an organisation. An address written here is published on the
         internet permanently and cannot be withdrawn, so putting one in is the
         operator's to do, not mine. -->
    <developers>
        <developer>
            <id>bentzn</id>
            <name>Thomas Elkjær Bentsen</name>
            <organization>Raposza</organization>
            <organizationUrl>https://github.com/raposza</organizationUrl>
        </developer>
    </developers>

    <!-- The inherit.append.path attributes stop Maven appending each module's
         artifactId to these, which would otherwise publish
         `.../OIDC/oidc-core` - a URL that resolves to nothing. -->
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/raposza/OIDC.git</connection>
        <developerConnection>scm:git:git@github.com:raposza/OIDC.git</developerConnection>
        <url>https://github.com/raposza/OIDC</url>
    </scm>

    <modules>
        <module>oidc-core</module>
        <module>oidc-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 10.10, 2026-10-05: CVE-2025-53864, GHSA-xwmg-2g98-w7v9 - a deeply
             nested claim set overflows the stack, reachable unauthenticated
             through `request=`. Fixed in 10.0.2; no 9.4x release carries it. -->
        <nimbus.jose.version>10.10</nimbus.jose.version>
        <!-- The 2.8 line is the Spring Boot 3.x one; springdoc 3.x is for
             Boot 4. Do NOT go below 2.8: springdoc 2.5 breaks on Spring
             Framework 6.2 with a NoSuchMethodError on ControllerAdviceBean,
             triggered by having a @RestControllerAdvice at all - which
             oidc-server does, in MintErrors. -->
        <springdoc.version>2.8.17</springdoc.version>

        <!-- PINNED RATHER THAN INHERITED. spring-boot-starter-parent manages
             some Maven plugins and not others, and which ones is not something
             to depend on. A version that is stated cannot move under the
             build. -->
        <maven.source.version>3.4.0</maven.source.version>
        <maven.javadoc.version>3.12.0</maven.javadoc.version>
        <maven.gpg.version>3.2.8</maven.gpg.version>
        <central.publishing.version>0.11.0</central.publishing.version>
        <maven.enforcer.version>3.6.3</maven.enforcer.version>
        <!-- Run by no gate here. 3.22.0 since 2026-10-05, from 3.3, the
             version Maven 3.8.7 binds: 3.3 put commons-collections 3.2.1,
             commons-beanutils 1.7.0 and Velocity 1.5 into the resolved plugin
             set - dependency report 20261005_0940Z. -->
        <maven.site.version>3.22.0</maven.site.version>
        <!-- 2.21.7 since 2026-10-05, from the 2.21.4 spring-boot-dependencies
             3.5.16 manages: CVE-2026-91777, GHSA-cxp5-3px4-pw24 - quadratic
             CPU in deserialization, fixed in 2.21.7. -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <!-- 1.5.38 and 2.25.5 since 2026-10-05, over the 1.5.34 and 2.24.3
             spring-boot-dependencies 3.5.16 manages: CVE-2026-13006,
             GHSA-567r-vvh5-jjr8 - conditional configuration, fully fixed in
             Logback 1.5.37; CVE-2026-49844, GHSA-qv9r-c865-cp47 - MapMessage
             JSON, fixed in Log4j 2.25.5. -->
        <logback.version>1.5.38</logback.version>
        <log4j2.version>2.25.5</log4j2.version>
        <!-- 3.20.0 since 2026-10-05, over the 3.17.0 spring-boot-dependencies
             3.5.16 manages: CVE-2025-48924, uncontrolled recursion in
             ClassUtils.getClass, fixed in 3.18.0 - dependency report
             20261005_1031Z and its review. 3.20.0 is what the rest of the
             tree resolves. -->
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <!-- 10.1.60 since 2026-10-05, over the 10.1.55 spring-boot-
             dependencies 3.5.16 manages: CVE-2026-65905, CVE-2026-65182,
             CVE-2026-68525, fixed in 10.1.59 per
             tomcat.apache.org/security-10.html - dependency report
             20261005_1130Z. 10.1.58 was never released. 10.1.60,
             2026-09-15, is the newest 10.1 release. -->
        <tomcat.version>10.1.60</tomcat.version>

        <!-- Raposza Design - Inter, Hack, the tokens; its own workspace and
             release. CARRIED in the fat jar and served from META-INF/resources:
             a standalone web component never loads them over the network.
             A release of this tree needs a released version here. -->
        <raposza.design.version>0.4.0</raposza.design.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.raposza.oidc</groupId>
                <artifactId>raposza-oidc-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.raposza.design</groupId>
                <artifactId>raposza-design</artifactId>
                <version>${raposza.design.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus.jose.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- WHAT CENTRAL REQUIRES OF EVERY PUBLISHED FILE: a sources jar and a
         javadoc jar beside the main one, .md5 and .sha1 checksums, and a .asc
         GPG signature over all of it. The POM requirements - name,
         description, url, a licence, a developer, scm - are above.

         THE TWO JAR PLUGINS ARE MANAGED HERE AND DECLARED IN THE MODULES, not
         declared here. A plugin in this file's <plugins> also runs against
         THIS project, which is packaging `pom` and has no sources; what the
         source and javadoc plugins then do is version-dependent and not worth
         depending on. Declaring them where there is code to read removes the
         question.

         THEY ARE IN THE ORDINARY BUILD, not behind the release profile, so
         `./build.sh` proves the files that get published. Signing is not: it
         needs a key, and a build that demands one to run the tests is a build
         nobody can run. -->
    <build>
        <pluginManagement>
            <plugins>
                <!-- Spring Boot manages these plugins and their versions
                     stay Boot's; only what they load is forced here. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <dependencies>
                        <!-- Forced since 2026-10-05, dependency report
                             20261005_1130Z: plexus-utils 4.0.3
                             (CVE-2025-67030, fixed in 4.0.3). -->
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>4.0.3</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <dependencies>
                        <!-- Forced since 2026-10-05, dependency report
                             20261005_1130Z: plexus-utils 4.0.3
                             (CVE-2025-67030, fixed in 4.0.3). -->
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>4.0.3</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <dependencies>
                        <!-- Forced since 2026-10-05, dependency report
                             20261005_1130Z: plexus-utils 4.0.3
                             (CVE-2025-67030, fixed in 4.0.3). -->
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>4.0.3</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <!-- Forced since 2026-10-05 over what Spring Boot's
                         version of this plugin brings: commons-beanutils
                         1.11.0 (CVE-2025-48734, fixed in 1.11.0);
                         commons-lang3 3.20.0 (CVE-2025-48924, fixed in
                         3.18.0). No gate runs it; the parent manages it, so
                         it is resolved, and dep_report.py lists it as forced
                         by the build. -->
                    <dependencies>
                        <dependency>
                            <groupId>commons-beanutils</groupId>
                            <artifactId>commons-beanutils</artifactId>
                            <version>1.11.0</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.commons</groupId>
                            <artifactId>commons-lang3</artifactId>
                            <version>3.20.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <!-- Forced since 2026-10-05 over what Spring Boot's
                         version of this plugin brings: commons-beanutils
                         1.11.0 (CVE-2025-48734, fixed in 1.11.0);
                         commons-lang3 3.20.0 (CVE-2025-48924, fixed in
                         3.18.0). No gate runs it; the parent manages it, so
                         it is resolved, and dep_report.py lists it as forced
                         by the build. -->
                    <dependencies>
                        <dependency>
                            <groupId>commons-beanutils</groupId>
                            <artifactId>commons-beanutils</artifactId>
                            <version>1.11.0</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.commons</groupId>
                            <artifactId>commons-lang3</artifactId>
                            <version>3.20.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.liquibase</groupId>
                    <artifactId>liquibase-maven-plugin</artifactId>
                    <!-- Forced since 2026-10-05 over what Spring Boot's
                         version of this plugin brings: commons-lang3 3.20.0
                         (CVE-2025-48924, fixed in 3.18.0). No gate runs it;
                         the parent manages it, so it is resolved, and
                         dep_report.py lists it as forced by the build. -->
                    <dependencies>
                        <dependency>
                            <groupId>org.apache.commons</groupId>
                            <artifactId>commons-lang3</artifactId>
                            <version>3.20.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <!-- Forced since 2026-10-05 over what this plugin brings:
                         commons-io 2.22.0 (CVE-2024-47554, fixed in 2.14.0).
                         It runs in the gate, so a breakage shows there, and
                         dep_report.py lists it as forced by the build. -->
                    <dependencies>
                        <dependency>
                            <groupId>commons-io</groupId>
                            <artifactId>commons-io</artifactId>
                            <version>2.22.0</version>
                        </dependency>
                        <!-- Forced since 2026-10-05, dependency report
                             20261005_1130Z: plexus-utils 4.0.3
                             (CVE-2025-67030, fixed in 4.0.3). -->
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>4.0.3</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <!-- Forced since 2026-10-05 over what this plugin brings:
                         commons-io 2.22.0 (CVE-2024-47554, fixed in 2.14.0);
                         commons-lang3 3.20.0 (CVE-2025-48924, fixed in
                         3.18.0). It runs in the gate, so a breakage shows
                         there, and dep_report.py lists it as forced by the
                         build. -->
                    <dependencies>
                        <dependency>
                            <groupId>commons-io</groupId>
                            <artifactId>commons-io</artifactId>
                            <version>2.22.0</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.commons</groupId>
                            <artifactId>commons-lang3</artifactId>
                            <version>3.20.0</version>
                        </dependency>
                        <!-- Forced since 2026-10-05, dependency report
                             20261005_1130Z: plexus-utils 3.6.1
                             (CVE-2025-67030, fixed in 3.6.1). -->
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>3.6.1</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <!-- Forced since 2026-10-05 over what this plugin brings:
                         commons-lang3 3.20.0 (CVE-2025-48924, fixed in
                         3.18.0). It runs in the gate, so a breakage shows
                         there, and dep_report.py lists it as forced by the
                         build. -->
                    <dependencies>
                        <dependency>
                            <groupId>org.apache.commons</groupId>
                            <artifactId>commons-lang3</artifactId>
                            <version>3.20.0</version>
                        </dependency>
                        <!-- Forced since 2026-10-05, dependency report
                             20261005_1130Z: plexus-utils 4.0.3
                             (CVE-2025-67030, fixed in 4.0.3); snappy 0.5
                             (CVE-2024-36124, fixed in 0.5). -->
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>4.0.3</version>
                        </dependency>
                        <dependency>
                            <groupId>org.iq80.snappy</groupId>
                            <artifactId>snappy</artifactId>
                            <version>0.5</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <!-- Forced since 2026-10-05 over what this plugin brings:
                         commons-lang3 3.20.0 (CVE-2025-48924, fixed in
                         3.18.0); jackson-databind and jackson-core 2.21.7
                         (CVE-2026-91777, fixed in 2.21.7). It runs in the
                         gate, so a breakage shows there, and dep_report.py
                         lists it as forced by the build. -->
                    <dependencies>
                        <dependency>
                            <groupId>org.apache.commons</groupId>
                            <artifactId>commons-lang3</artifactId>
                            <version>3.20.0</version>
                        </dependency>
                        <dependency>
                            <groupId>com.fasterxml.jackson.core</groupId>
                            <artifactId>jackson-databind</artifactId>
                            <version>2.21.7</version>
                        </dependency>
                        <dependency>
                            <groupId>com.fasterxml.jackson.core</groupId>
                            <artifactId>jackson-core</artifactId>
                            <version>2.21.7</version>
                        </dependency>
                        <!-- Forced since 2026-10-05, dependency report
                             20261005_1130Z: plexus-utils 3.6.1
                             (CVE-2025-67030, fixed in 3.6.1); httpclient5
                             5.6.3 (CVE-2026-64607, fixed in 5.6.3); httpcore5
                             5.4.3 (CVE-2026-54399, fixed in 5.4.3);
                             httpcore5-h2 5.4.3 (CVE-2026-54428, fixed in
                             5.4.3). -->
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>3.6.1</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.httpcomponents.client5</groupId>
                            <artifactId>httpclient5</artifactId>
                            <version>5.6.3</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.httpcomponents.core5</groupId>
                            <artifactId>httpcore5</artifactId>
                            <version>5.4.3</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.httpcomponents.core5</groupId>
                            <artifactId>httpcore5-h2</artifactId>
                            <version>5.4.3</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven.source.version}</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                    <dependencies>
                        <!-- Forced since 2026-10-05, dependency report
                             20261005_1130Z: plexus-utils 4.0.3
                             (CVE-2025-67030, fixed in 4.0.3). -->
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>4.0.3</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven.javadoc.version}</version>
                    <configuration>
                        <!-- DOCLINT IS OFF DELIBERATELY. The javadoc jar is a
                             distribution requirement, not a quality gate.
                             Turning doclint loose on a tree that has never run
                             it fails the build on heading order and missing
                             @param tags - formatting, not defects - and the
                             loop costs more than it finds. Javadoc AS a gate
                             is a separate decision. -->
                        <doclint>none</doclint>
                        <quiet>true</quiet>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                    <!-- BeanUtils 1.11.0 since 2026-10-05, over the 1.9.4 this plugin
                         brings: CVE-2025-48734, the declaredClass property reaching an
                         enum's classloader, fixed in 1.11.0 - dependency report
                         20261005_1031Z and its review. The plugin runs in the gate, so a
                         breakage shows there. -->
                    <dependencies>
                        <dependency>
                            <groupId>commons-beanutils</groupId>
                            <artifactId>commons-beanutils</artifactId>
                            <version>1.11.0</version>
                        </dependency>
                        <!-- 2026-10-05: commons-codec 1.21.0, the version the
                             rest of the tree resolves, over the 1.11 it brings. -->
                        <dependency>
                            <groupId>commons-codec</groupId>
                            <artifactId>commons-codec</artifactId>
                            <version>1.21.0</version>
                        </dependency>
                        <!-- Forced since 2026-10-05, dependency report
                             20261005_1130Z: plexus-utils 4.0.3
                             (CVE-2025-67030, fixed in 4.0.3). -->
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>4.0.3</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven.site.version}</version>
                    <dependencies>
                        <!-- Forced since 2026-10-05, dependency report
                             20261005_1130Z: jsoup 1.23.1 (CVE-2026-71497,
                             fixed in 1.23.1). -->
                        <dependency>
                            <groupId>org.jsoup</groupId>
                            <artifactId>jsoup</artifactId>
                            <version>1.23.1</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Binds to the DEPLOY phase and replaces maven-deploy-plugin,
                 which is what extensions=true does. `mvn install` never
                 reaches it, so build.sh and test.sh cannot publish anything.

                 THE TOKEN IS NOT IN THIS TREE and never will be. It lives in
                 ~/.m2/settings.xml under a <server> whose id is the one named
                 here. -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${central.publishing.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <!-- FALSE ON PURPOSE. The upload stops at the portal and
                         waits to be released by hand. A coordinate on Central
                         can never be replaced, only superseded, and the last
                         gate before a door that does not reopen should not be
                         a build flag. -->
                    <autoPublish>false</autoPublish>
                </configuration>
                <dependencies>
                    <!-- Forced since 2026-10-05, dependency report
                         20261005_1130Z: plexus-utils 3.6.1 (CVE-2025-67030,
                         fixed in 3.6.1); httpclient5 5.6.3 (CVE-2026-64607,
                         fixed in 5.6.3); httpcore5 5.4.3 (CVE-2026-54399,
                         fixed in 5.4.3); httpcore5-h2 5.4.3 (CVE-2026-54428,
                         fixed in 5.4.3). -->
                    <dependency>
                        <groupId>org.codehaus.plexus</groupId>
                        <artifactId>plexus-utils</artifactId>
                        <version>3.6.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.httpcomponents.client5</groupId>
                        <artifactId>httpclient5</artifactId>
                        <version>5.6.3</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.httpcomponents.core5</groupId>
                        <artifactId>httpcore5</artifactId>
                        <version>5.4.3</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.httpcomponents.core5</groupId>
                        <artifactId>httpcore5-h2</artifactId>
                        <version>5.4.3</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- SUPPLY CHAIN. No repository in this pom or its parents, every
                 plugin the clean and default lifecycles run carries a stated
                 version, and no dependency version moves on its own. Tightened,
                 never weakened to make a build pass. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.version}</version>
                <executions>
                    <execution>
                        <id>supply-chain</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireNoRepositories/>
                                <requirePluginVersions/>
                                <banDynamicVersions>
                                    <allowSnapshots>false</allowSnapshots>
                                    <!-- This reactor's own module, built in the same run. -->
                                    <ignores>
                                        <ignore>com.raposza.oidc:raposza-oidc-core</ignore>
                                    </ignores>
                                </banDynamicVersions>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- `mvn -Prelease deploy`, and nothing else uses it. -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven.gpg.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <dependencies>
                            <!-- Forced since 2026-10-05, dependency report
                                 20261005_1130Z: plexus-utils 3.6.1
                                 (CVE-2025-67030, fixed in 3.6.1). -->
                            <dependency>
                                <groupId>org.codehaus.plexus</groupId>
                                <artifactId>plexus-utils</artifactId>
                                <version>3.6.1</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
